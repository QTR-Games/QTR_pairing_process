{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KLIK KLAK",
  "version": "0.1.0",
  "identifier": "com.qtrgames.klikklak",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "KLIK KLAK",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "QTR Games",
    "category": "Sports",
    "shortDescription": "5v5 tournament pairing planner",
    "longDescription": "KLIK KLAK is the QTR pairing planner for 5v5 tournaments: build boards, compare fractions, and drive event-day matchup decisions offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4RTY4NEE1RTEzMDg1QjIKUldTeWhURGhwWVRtZUQxZUlaOUprNmEzaTlOOEdYWGpKRUp6YkVmZEhwaloyOFhEa082cWhOVlEK",
      "endpoints": [
        "https://github.com/QTR-Games/QTR_pairing_process/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
